# Data provider: stooq (free, no API key) or alpaca
DATA_PROVIDER=stooq

# Alpaca settings (required only for DATA_PROVIDER=alpaca)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex

# Stooq settings (free online data)
STOOQ_SYMBOL_SOURCE=sec
SYMBOL_LIMIT=400

LOOKBACK_DAYS=320
UNIVERSE_EXCHANGES=NYSE,NASDAQ,AMEX
INCLUDE_ETFS=true
YELLOW_TOLERANCE_PCT=10
DISCORD_WEBHOOK_URL=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
RESULTS_DIR=results

# Kalshi demo scaffold (optional)
KALSHI_BASE_URL=https://demo-api.kalshi.co
KALSHI_EMAIL=
KALSHI_PASSWORD=
